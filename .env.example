# MongoDB Atlas (atau lokal: mongodb://127.0.0.1:27017/nexus)
MONGODB_URI=mongodb://127.0.0.1:27017/nexus

# Auth.js — buat dengan: npx auth secret   (atau: openssl rand -base64 32)
AUTH_SECRET=
# Opsional: login Google. Tanpa ini tombol Google disembunyikan.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# AI Coach. Urutan pilihan: AI_PROVIDER (gemini|anthropic|heuristic) → GEMINI_API_KEY → ANTHROPIC_API_KEY → heuristik.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# AI_PROVIDER=gemini
