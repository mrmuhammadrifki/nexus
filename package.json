{
  "name": "nexus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "migrate:levels": "tsx --env-file=.env.local scripts/migrate-levels.ts",
    "test": "npm run test:unit && npm run test:api && npm run test:e2e",
    "test:unit": "vitest run -c vitest.unit.config.mts",
    "test:api": "vitest run -c vitest.api.config.mts",
    "test:e2e": "playwright test",
    "test:report": "playwright show-report",
    "test:ai-live": "TEST_LIVE_AI=1 node --env-file=.env.local node_modules/vitest/vitest.mjs run -c vitest.live.config.mts",
    "docs:screenshots": "tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@auth/mongodb-adapter": "^3.11.3",
    "bcryptjs": "^3.0.3",
    "mongodb": "^6.22.0",
    "mongoose": "^9.12.0",
    "next": "^15.5.29",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
